      <bpmndi:BPMNShape id="Gateway_RepeatCheck_repeat_block_di" bpmnElement="Gateway_RepeatCheck_repeat_block" isMarkerVisible="true">
        <dc:Bounds x="1395" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Completed_di" bpmnElement="EndEvent_Completed">
        <dc:Bounds x="1562" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="158" y="180" />
        <di:waypoint x="275" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="325" y="180" />
        <di:waypoint x="410" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="510" y="180" />
        <di:waypoint x="595" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="645" y="180" />
        <di:waypoint x="665" y="180" />
        <di:waypoint x="665" y="60" />
        <di:waypoint x="730" y="60" />
      </bpmndi:BPMNEdge>
