<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_SimClaims" name="Document Request Preparation" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:exclusiveGateway id="Gateway_LoopEntry_repeat_block" name="Loop Entry" />
    <bpmn:userTask id="Task_req_docs" name="Request Missing Documents" />
    <bpmn:exclusiveGateway id="Gateway_Split_prep_choice" name="Select Preparation Team" />
    <bpmn:exclusiveGateway id="Gateway_Merge_prep_choice" name="Merge" />
    <bpmn:userTask id="Task_task_std_prep" name="Standard Document Preparation" />
    <bpmn:userTask id="Task_task_spec_prep" name="Specialist Document Preparation" />
    <bpmn:userTask id="Task_cust_response" name="Receive Customer Response" />
    <bpmn:serviceTask id="Task_assess_outcome" name="Assess Claim Outcome" />
    <bpmn:exclusiveGateway id="Gateway_RepeatCheck_repeat_block" name="Document Request Cycle" />
    <bpmn:endEvent id="EndEvent_Completed" name="Completed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Gateway_LoopEntry_repeat_block" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Gateway_LoopEntry_repeat_block" targetRef="Task_req_docs" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_req_docs" targetRef="Gateway_Split_prep_choice" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_Split_prep_choice" targetRef="Task_task_std_prep" name="Standard Preparation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">team == &quot;standard&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_task_std_prep" targetRef="Gateway_Merge_prep_choice" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_Split_prep_choice" targetRef="Task_task_spec_prep" name="Specialist Preparation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">team == &quot;specialist&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_task_spec_prep" targetRef="Gateway_Merge_prep_choice" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Merge_prep_choice" targetRef="Task_cust_response" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_cust_response" targetRef="Task_assess_outcome" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_assess_outcome" targetRef="Gateway_RepeatCheck_repeat_block" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_RepeatCheck_repeat_block" targetRef="Gateway_LoopEntry_repeat_block" name="Repeat">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">outcome == &quot;another_request&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_RepeatCheck_repeat_block" targetRef="EndEvent_Completed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_SimClaims">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_SimClaims" bpmnElement="Process_SimClaims">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="122" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_LoopEntry_repeat_block_di" bpmnElement="Gateway_LoopEntry_repeat_block" isMarkerVisible="true">
        <dc:Bounds x="275" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_req_docs_di" bpmnElement="Task_req_docs">
