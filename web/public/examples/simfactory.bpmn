<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_SimFactory" name="Manufacturing Repair and Reinspection" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:exclusiveGateway id="Gateway_LoopEntry_repair_repeat" name="Loop Entry" />
    <bpmn:exclusiveGateway id="Gateway_Split_repair_choice" name="Assign Repair Team" />
    <bpmn:exclusiveGateway id="Gateway_Merge_repair_choice" name="Merge" />
    <bpmn:userTask id="Task_t_std_repair" name="Execute Standard Repair" />
    <bpmn:userTask id="Task_t_spec_repair" name="Execute Specialist Repair" />
    <bpmn:userTask id="Task_reinspect_task" name="Reinspect Repaired Part" />
    <bpmn:exclusiveGateway id="Gateway_RepeatCheck_repair_repeat" name="Repair and Reinspect Loop" />
    <bpmn:task id="Task_pack_task" name="Package Passed Part" />
    <bpmn:endEvent id="EndEvent_Completed" name="Completed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Gateway_LoopEntry_repair_repeat" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Gateway_LoopEntry_repair_repeat" targetRef="Gateway_Split_repair_choice" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_Split_repair_choice" targetRef="Task_t_std_repair" name="Standard Repair Team" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_t_std_repair" targetRef="Gateway_Merge_repair_choice" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Split_repair_choice" targetRef="Task_t_spec_repair" name="Specialist Repair Team" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_t_spec_repair" targetRef="Gateway_Merge_repair_choice" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_Merge_repair_choice" targetRef="Task_reinspect_task" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_reinspect_task" targetRef="Gateway_RepeatCheck_repair_repeat" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_RepeatCheck_repair_repeat" targetRef="Gateway_LoopEntry_repair_repeat" name="Repeat">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">inspectionStatus == &quot;needs_repair&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_RepeatCheck_repair_repeat" targetRef="Task_pack_task" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_pack_task" targetRef="EndEvent_Completed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_SimFactory">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_SimFactory" bpmnElement="Process_SimFactory">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="122" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_LoopEntry_repair_repeat_di" bpmnElement="Gateway_LoopEntry_repair_repeat" isMarkerVisible="true">
        <dc:Bounds x="275" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Split_repair_choice_di" bpmnElement="Gateway_Split_repair_choice" isMarkerVisible="true">
        <dc:Bounds x="435" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Merge_repair_choice_di" bpmnElement="Gateway_Merge_repair_choice" isMarkerVisible="true">
        <dc:Bounds x="755" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_t_std_repair_di" bpmnElement="Task_t_std_repair">
        <dc:Bounds x="570" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_t_spec_repair_di" bpmnElement="Task_t_spec_repair">
        <dc:Bounds x="570" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_reinspect_task_di" bpmnElement="Task_reinspect_task">
        <dc:Bounds x="890" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RepeatCheck_repair_repeat_di" bpmnElement="Gateway_RepeatCheck_repair_repeat" isMarkerVisible="true">
        <dc:Bounds x="1075" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_pack_task_di" bpmnElement="Task_pack_task">
        <dc:Bounds x="1210" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Completed_di" bpmnElement="EndEvent_Completed">
        <dc:Bounds x="1402" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="158" y="180" />
        <di:waypoint x="275" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="325" y="180" />
        <di:waypoint x="435" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="485" y="180" />
        <di:waypoint x="505" y="180" />
        <di:waypoint x="505" y="60" />
        <di:waypoint x="570" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="670" y="60" />
        <di:waypoint x="690" y="60" />
        <di:waypoint x="690" y="180" />
        <di:waypoint x="755" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="485" y="180" />
        <di:waypoint x="505" y="180" />
        <di:waypoint x="505" y="300" />
        <di:waypoint x="570" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="670" y="300" />
        <di:waypoint x="690" y="300" />
        <di:waypoint x="690" y="180" />
        <di:waypoint x="755" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="805" y="180" />
        <di:waypoint x="890" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="990" y="180" />
        <di:waypoint x="1075" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1100" y="205" />
        <di:waypoint x="1100" y="420" />
        <di:waypoint x="300" y="420" />
        <di:waypoint x="300" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1125" y="180" />
        <di:waypoint x="1210" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1310" y="180" />
        <di:waypoint x="1402" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>