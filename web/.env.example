# Gemini 2.5 Flash API credentials (obtain from https://aistudio.google.com)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Research Simulation Backend
RESEARCH_API_URL=http://localhost:8000

# Camunda 8 Integration
CAMUNDA_EXECUTION_ENABLED=true
CAMUNDA_EXPECTED_VERSION=8.8
CAMUNDA_REST_ADDRESS=http://localhost:8080

# Path to Camunda Modeler executable (optional - auto-detected if installed in standard paths)
CAMUNDA_MODELER_PATH=
